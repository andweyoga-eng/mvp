# andWeYoga Environment Variables
# Copy this to .env and fill in real values. Never commit .env to git.

# Optional. Defaults to 3000 locally. Use 5000 on Replit or if you prefer.
# PORT=3000

DATABASE_URL=postgresql://user:password@host:5432/andweyoga
# Railway Postgres also exposes DATABASE_PUBLIC_URL (TCP proxy). The server prefers it
# when set, so the app avoids ENOTFOUND on postgres.railway.internal. In Railway: add a
# variable reference from Postgres → DATABASE_PUBLIC_URL on your web service (optional
# if private DATABASE_URL resolves in your network).
# DATABASE_PUBLIC_URL=postgresql://...
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
ALLOWED_ORIGIN=andweyoga.com
NODE_ENV=production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SENDGRID_API_KEY=your-sendgrid-api-key

# Member emails (Google Workspace SMTP — used by server/email.ts)
GMAIL_USER=your-official@andweyoga.com
GMAIL_APP_PASSWORD=your-google-app-password

# Razorpay (professional account — Checkout + webhooks)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# From Razorpay Dashboard → Webhooks → secret for payment.captured / order.paid
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Admin login (webapp service on Railway — copy the same values into local .env for localhost)
# On each server start, the primary admin row is synced to this password (and optional email/name).
# ADMIN_INITIAL_EMAIL=admin@yourdomain.com
# ADMIN_INITIAL_NAME=System Administrator
# ADMIN_INITIAL_PASSWORD=use-a-strong-password-min-8-chars

# ---------------------------------------------------------------------------
# Health document uploads (choose ONE backend)
# ---------------------------------------------------------------------------
# NOTE: In-app upload HTTP routes are currently OFF in code. Set
# ENABLE_HEALTH_DOCUMENT_OBJECT_ROUTES = true in server/routes.ts to register
# POST /api/objects/upload, GET /objects/*, PUT /api/health-documents after you
# configure storage below.
#
# Recommended: S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, …)
# OBJECT_STORAGE=s3
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# Optional custom endpoint (required for Cloudflare R2):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
#
# Legacy: Replit Object Storage (requires Replit sidecar + GCS paths)
# OBJECT_STORAGE=replit
# PRIVATE_OBJECT_DIR=/your-bucket/private/prefix
# PUBLIC_OBJECT_SEARCH_PATHS=/optional/public/prefix
